<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Binacle.ViPaq\Binacle.ViPaq.csproj" />
    <ProjectReference Include="..\..\..\shared\src\Binacle.Geometry\Binacle.Geometry.csproj" />
    <ProjectReference Include="..\..\..\shared\src\Binacle.CompactNotation\Binacle.CompactNotation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protobuf\packing.proto" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Frozen placed-result data, generated offline by Binacle.ViPaq.PackedDataGenerator. Embedded so
      RealDataProvider reads the exact committed files with no lib dependency at run time. One entry per family
      folder (bischoff-suite / custom-problems) with a flat "*.ffd.json" glob — no RecursiveDir, so the
      LogicalName "PackedData.<family>.<file>" stays clean and the reader enumerates by the "PackedData." prefix.
      The ".ffd" is the algorithm; a second algorithm drops ".bfd.json" files the same globs pick up. Link keeps
      the out-of-project files under a virtual Data/ folder in the IDE. Rebuild after regenerating the data.
    -->
    <EmbeddedResource Include="..\..\data\packed\bischoff-suite\*.ffd.json">
      <Link>Data\bischoff-suite\%(Filename)%(Extension)</Link>
      <LogicalName>PackedData.bischoff-suite.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\data\packed\custom-problems\*.ffd.json">
      <Link>Data\custom-problems\%(Filename)%(Extension)</Link>
      <LogicalName>PackedData.custom-problems.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Binacle.Geometry" />
  </ItemGroup>

</Project>
