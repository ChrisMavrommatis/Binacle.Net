[
  {
    "Name": "8-bit values",
    "Bin": "100x110x120",
    "Items": ["10x20x30 (1,2,3)", "40x50x60 (10,20,30)"],
    "ExpectedEncodingInfo": "Uncompressed_8_8_8"
  },
  {
    "Name": "16-bit values",
    "Bin": "1000x2000x3000",
    "Items": ["300x400x500 (600,700,800)"],
    "ExpectedEncodingInfo": "Uncompressed_16_16_16"
  },
  {
    "Name": "32-bit values",
    "Bin": "100000x200000x300000",
    "Items": ["70000x80000x90000 (100000,110000,120000)"],
    "ExpectedEncodingInfo": "Uncompressed_32_32_32"
  },
  {
    "Name": "zero coordinates",
    "Bin": "100x110x120",
    "Items": ["10x20x30 (0,0,0)"],
    "ExpectedEncodingInfo": "Uncompressed_8_8_8"
  },
  {
    "Name": "no items",
    "Bin": "100x110x120",
    "Items": [],
    "ExpectedEncodingInfo": "Uncompressed_8_8_8"
  },
  {
    "Name": "multiple distinct items",
    "Bin": "10x20x30",
    "Items": ["1x2x3 (10,11,12)", "4x5x6 (13,14,15)", "7x8x9 (16,17,18)"],
    "ExpectedEncodingInfo": "Uncompressed_8_8_8"
  },
  {
    "Name": "compressed body",
    "Bin": "200x200x200",
    "Items": ["10x20x30 (1,2,3):60"],
    "ExpectedEncodingInfo": "Compressed_8_8_8"
  },
  {
    "Name": "item count over 255",
    "Bin": "10x20x30",
    "Items": ["1x2x3 (4,5,6):300"],
    "ExpectedEncodingInfo": "Compressed_8_8_8"
  },
  {
    "Name": "just under compression threshold (stays raw)",
    "Bin": "300x300x300",
    "Items": ["1x2x3 (4,5,6):41"],
    "ExpectedEncodingInfo": "Uncompressed_16_8_8"
  },
  {
    "Name": "just over compression threshold (compresses)",
    "Bin": "10x20x30",
    "Items": ["1x2x3 (4,5,6):42"],
    "ExpectedEncodingInfo": "Compressed_8_8_8"
  }
]
