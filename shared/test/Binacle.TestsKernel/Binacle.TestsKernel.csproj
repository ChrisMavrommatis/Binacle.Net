<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
      <IsPackable>false</IsPackable>

  </PropertyGroup>

    <!--
        Fixtures are sourced from shared/data (one place they're generated/edited, one place they live), not kernel
        copies. Both sets are read by more than one slice, which is why they live in shared/data rather than in a
        slice: the api integration suite and the lib tests read them through this kernel, and the ViPaq packed-data
        generator reads the same files by path at run time. LogicalName reproduces the manifest name the reader
        expects. Link keeps these out-of-project files under a virtual folder in the IDE instead of scattering them
        at the project root. Bischoff suite is the OR-Library converter's output; custom-problems are hand-authored.
        One flat entry per folder (no ** wildcard): a recursive wildcard with %(RecursiveDir) would inject a
        backslash into LogicalName and corrupt the manifest name.
    -->
    <ItemGroup>
        <EmbeddedResource Include="..\..\data\bischoff-suite\*.json">
            <Link>Algorithms\Data\BischoffSuite\%(Filename)%(Extension)</Link>
            <LogicalName>Binacle.TestsKernel.Algorithms.Data.BischoffSuite.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="..\..\data\custom-problems\*.json">
            <Link>Algorithms\Data\CustomProblems\%(Filename)%(Extension)</Link>
            <LogicalName>Binacle.TestsKernel.Algorithms.Data.CustomProblems.%(Filename)%(Extension)</LogicalName>
        </EmbeddedResource>
    </ItemGroup>


    <ItemGroup>
        <ProjectReference Include="..\..\src\Binacle.Packing\Binacle.Packing.csproj" />
        <ProjectReference Include="..\..\src\Binacle.CompactNotation\Binacle.CompactNotation.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Binacle.Geometry" />
        <Using Include="Binacle.Packing" />
    </ItemGroup>

</Project>
