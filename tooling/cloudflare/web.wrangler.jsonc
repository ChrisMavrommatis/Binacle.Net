{
  "name": "binacle-net-web",
  "compatibility_date": "2026-08-20",
  // Off: a deploy is meant to be the site, not a second copy of it on a second URL.
  "preview_urls": false,
  // Request metadata, 404s and exceptions. The only way to see a dead inbound link - the link
  // check runs offline and cannot know what anyone typed.
  "observability": {
    "enabled": true
  },
  "assets": {
    // Relative to this file, matching the `destination` in web/_config.yml so the two are wrong together.
    "directory": "../../artifacts/web",
    // Wants `404.html` in the site root, which is why pages/404.html has `permalink: /404.html`.
    "not_found_handling": "404-page"
  }
}
