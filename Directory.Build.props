<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Xunit.Analyzers' MemberDataShouldReferenceValidMember crashes (raises AD0001, "Sequence contains
             no elements") on valid member data in xunit.v3 3.2.2 — the latest, so there is nothing to upgrade
             to. It is an analyzer bug, not our code. AD0001 is raised by the analyzer driver and ignores
             editorconfig severity, so suppress it with NoWarn to stop it flooding every test build. -->
        <NoWarn>$(NoWarn);AD0001</NoWarn>
    </PropertyGroup>

    <!--
        Tell Sonar which projects are support code. The Scanner for .NET spots a test project by its
        Microsoft.NET.Test.Sdk reference, so it finds the xunit suites on its own but reads the eleven projects
        without one - all three test kernels, TestReporting, the benchmarks, the performance suites and the
        generator/converter tools - as product code. That put 1203 lines into the coverage denominator that no
        test will ever cover, and ran the product rule set over them: S101 firing on benchmark names like
        BestBin_ResultSelection, and S2223 on the TestsKernel key holders, are both that. The 1203 was measured
        when there were ten, before Binacle.Lib.TestsKernel was split out.

        Every project under a test/ or tools/ folder is support code, so the layout decides it and nothing has
        to be listed. Marking the xunit suites too is a no-op - the scanner already had them.

        SonarQubeTestProject is read only by the scanner's targets, which are injected during a Sonar run and
        absent otherwise, so a normal build does not see this. Sonar still runs test-scope rules on these
        files: the [AssertionMethod] markers for S2699 stay load-bearing.
    -->
    <PropertyGroup>
        <!-- MSBuildProjectDirectory is separator-native, so normalise before matching or this misses on Linux. -->
        <_BinacleProjectPath>$(MSBuildProjectDirectory.Replace('\', '/'))</_BinacleProjectPath>
        <SonarQubeTestProject Condition="$(_BinacleProjectPath.Contains('/test/')) or $(_BinacleProjectPath.Contains('/tools/'))">true</SonarQubeTestProject>
    </PropertyGroup>
</Project>