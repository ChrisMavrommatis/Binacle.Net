{
  "name": "binacle-net-uimodule",
  "version": "1.0.0",
  "description": "The JS bundle and stylesheet the UI module ships inside the Docker image",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "sass --no-source-map --style=compressed _sass/main.scss wwwroot/css/main.css",
    "build:js": "webpack --env build=dist",
    "watch": "concurrently --names 'css,js' 'npm:watch:css' 'npm:watch:js'",
    "watch:css": "sass --watch _sass/main.scss wwwroot/css/main.css",
    "watch:js": "webpack --watch --env build=watch"
  },
  "dependencies": {
    "alpinejs": "^3.15.2",
    "binacle-net-ui": "*",
    "binacle-vipaq": "*",
    "cookies": "*",
    "theme-switcher": "*",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "sass": "^1.93.2",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  }
}
