<nav class="m l left secondary">
	<header>
		<Logo class="large" />
	</header>
	@if (menuItems is not null)
	{
		@foreach (var menuItem in menuItems)
		{
			<NavLink href="@menuItem.Url" ActiveClass="active">
				@menuItem.Content.Render()
				<span>@menuItem.Title</span>
			</NavLink>
		}
	}
	
</nav>

<nav class="s bottom secondary">
	@if (menuItems is not null)
	{
		@foreach (var menuItem in menuItems)
		{
			<NavLink href="@menuItem.Url" ActiveClass="active">
				@menuItem.Content.Render()
				<span>@menuItem.Title</span>
			</NavLink>
		}
	}
</nav>

@code {

	[Inject]
	private Services.AppletsService? AppletsService { get; set; }

	// Built once here rather than from a property. The markup reads it four times - twice per nav, in the
	// `is not null` check and the `foreach` - and as an expression-bodied property each of those rebuilt the
	// list and allocated a MaterialSymbol per applet. AppletsService.Applets is fixed in its constructor and
	// never mutated, so there is nothing to recompute.
	private List<Models.LinkWithContent>? menuItems;

	protected override void OnInitialized()
	{
		// MaterialSymbol is built here as a content model (IRendableContentComponent), not rendered as a
		// component, so setting its Name parameter directly is intended. BL0005 does not apply.
#pragma warning disable BL0005
		this.menuItems = this.AppletsService?.Applets
			.Select(applet => new Models.LinkWithContent(applet.Title, applet.Ref, new MaterialSymbol()
			{
				Name = applet.Icon
			}))
			.ToList();
#pragma warning restore BL0005

		base.OnInitialized();
	}

}