<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<UserSecretsId>Binacle_Net_Secrets</UserSecretsId>
		<RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
	</PropertyGroup>

	<!-- Emit the OpenAPI documents (v3, v4) at build time, so SDK generation never needs a running server.
	     Off by default because it runs the app host on every build; opt in with -p:GenerateOpenApi=true. -->
	<PropertyGroup>
		<GenerateOpenApi Condition="'$(GenerateOpenApi)' == ''">false</GenerateOpenApi>
		<OpenApiGenerateDocumentsOnBuild>$(GenerateOpenApi)</OpenApiGenerateDocumentsOnBuild>
		<OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../../build/openapi</OpenApiDocumentsDirectory>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="$(ProjectName).UnitTests" />
		<InternalsVisibleTo Include="$(ProjectName).IntegrationTests" />
		<InternalsVisibleTo Include="$(ProjectName).ServiceModule.IntegrationTests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
		<PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="OpenApiExamples" Version="1.0.1" />
		<PackageReference Include="Scalar.AspNetCore" Version="2.16.13" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="FluentValidation" Version="12.1.1" />
		<PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\..\vipaq\src\Binacle.ViPaq\Binacle.ViPaq.csproj" />
	  <ProjectReference Include="..\Binacle.Net.DiagnosticsModule\Binacle.Net.DiagnosticsModule.csproj" />
	  <ProjectReference Include="..\Binacle.Net.ServiceModule\Binacle.Net.ServiceModule.csproj" />
	  <ProjectReference Include="..\Binacle.Net.UIModule\Binacle.Net.UIModule.csproj" />
	  <ProjectReference Include="..\..\..\lib\src\Binacle.Lib\Binacle.Lib.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Binacle.Geometry" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="Config_Files\**\*.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>
